# Database connection (Postgres)
# Example (Docker Compose): postgres://user:password@db:5432/revestidas
# Example (local with host mapping): postgres://postgres:postgres@localhost:5434/revestidas
DATABASE_URL=postgres://postgres:postgres@localhost:5434/revestidas

# JWT secret used to sign admin session cookie. CHANGE this in production.
JWT_SECRET=changeme_dev_secret

# App port
PORT=4002

# When using Docker Compose, the DB host is 'db'. For local development you can
# point DATABASE_URL to a local Postgres instance.

# Notes:
# - Do NOT commit real secrets to the repo. Use GitHub Actions secrets or a
#   secrets manager for CI/production.
# - Replace JWT_SECRET with a long random string in production (e.g., 32+ chars).DATABASE_HOST=db
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=revestidas
PORT=4002
